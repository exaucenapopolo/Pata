<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pata_quick_actions_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/pata_widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAISIE RAPIDE"
        android:textColor="#D7EEE6"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pata_quick_action_expense"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="5dp"
            android:text="DÉPENSE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/pata_widget_card"/>

        <TextView
            android:id="@+id/pata_quick_action_income"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="REVENU"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/pata_widget_card"/>

        <TextView
            android:id="@+id/pata_quick_action_voice"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="VOIX"
            android:textColor="#B8F2D4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/pata_widget_card"/>
    </LinearLayout>
</LinearLayout>
