{
  "crons": [
    {
      "path": "/api/automations/scheduler",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/notifications/scheduler",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/notifications/evening-followup",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/notifications/weekend-scheduler",
      "schedule": "0 17 * * 0,5"
    },
    {
      "path": "/api/notifications/weekend-scheduler",
      "schedule": "30 16 * * 6"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
