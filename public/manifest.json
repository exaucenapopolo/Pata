{
  "name": "Pata - Gestion Financière",
  "short_name": "Pata",
  "description": "Ton espace personnel pour suivre tes revenus, maîtriser tes dépenses et organiser ton épargne.",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#f5f8f6",
  "theme_color": "#075b43",
  "orientation": "any",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "scope": "/",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "shortcuts": [
    {
      "name": "Ajouter une dépense",
      "short_name": "Dépense",
      "description": "Enregistrer une nouvelle dépense dans Pata.",
      "url": "/expenses?new=1",
      "icons": [
        {
          "src": "/shortcuts/expense.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Ajouter un revenu",
      "short_name": "Revenu",
      "description": "Enregistrer un nouveau revenu dans Pata.",
      "url": "/income?new=1",
      "icons": [
        {
          "src": "/shortcuts/income.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Ajouter une facture",
      "short_name": "Facture",
      "description": "Créer une facture ou une échéance.",
      "url": "/bills?new=1",
      "icons": [
        {
          "src": "/shortcuts/bill.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Mes cotisations",
      "short_name": "Cotisations",
      "description": "Accéder rapidement aux groupes de cotisation.",
      "url": "/cotisations",
      "icons": [
        {
          "src": "/shortcuts/cotisations.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
